{
  "name": "nexmart-server",
  "version": "1.0.0",
  "description": "NexMart REST API — Express · PostgreSQL · Argon2",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon --exec \"node --env-file=.env.development server.js\"",
    "start": "node server.js",
    "db:init": "psql -U postgres -d NexMart-db -f sql/schema.sql",
    "db:seed": "node sql/seed.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "argon2": "^0.40.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
